# 复制成 .env.local 再填（.env.local 不提交）
#
# 数字人的 DeepSeek 通道。不填也能用——会自动回落到本地知识检索层。
#
# 当前阶段（服务器还没下来）：直接填 VITE_DEEPSEEK_API_KEY，
# Key 会被打进前端产物，访客打开就能用。这也意味着任何人看 DevTools
# 都能拿走这个 Key —— 只能靠单独的 Key + 每日预算控制风险。
#
# 服务器就绪后：跑 proxy/deepseek-proxy.mjs，把下面换成代理地址，
# 并删掉 VITE_DEEPSEEK_API_KEY。前端代码不用改。
VITE_DEEPSEEK_API_KEY=

# 可选：默认 https://api.deepseek.com
VITE_DEEPSEEK_BASE=

# 代理地址，例如 https://你的域名/dhapi（前端会请求 /chat）
# 填了这一项就走代理，不再需要上面的 Key。
VITE_DEEPSEEK_PROXY=

# 每日花费上限（元），到量自动回落本地知识库。
# 注意：这是每个浏览器各自计数的，不是全站共享额度。
VITE_DH_DAILY_CNY=2
