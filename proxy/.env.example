# 复制成 proxy/.env 再填（proxy/.env 已在 .gitignore 里，不会提交）
#
# DeepSeek API Key。只在服务器端使用，前端拿不到。
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 代理监听端口
PORT=8787

# 允许跨域的前端来源，逗号分隔；生产环境换成真实域名
ALLOW_ORIGINS=http://localhost:5177,http://127.0.0.1:5177

# 每日总预算（元），到量自动拒绝并让前端回落本地知识库
DAILY_CNY=2

# 单 IP 每分钟 / 每天请求数
PER_IP_MIN=8
PER_IP_DAY=200

# 单次回答的最大 tokens
MAX_TOKENS=320

# 用量账本文件
STORE=proxy/usage.json
